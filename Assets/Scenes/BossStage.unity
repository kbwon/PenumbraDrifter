MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1778340830}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8265f44d3abbd8f48865afebd4d86a3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossStageIntroDirector
  dialogue: {fileID: 0}
  player: {fileID: 0}
  shadow: {fileID: 0}
  followCamera: {fileID: 0}
  boss: {fileID: 743302809}
  bossFocusPoint: {fileID: 785894826}
  bossFocusYaw: 45
  bossFocusOrthoSize: 7
  focusMoveSeconds: 1
  returnMoveSeconds: 1
  playOnStart: 1
  introLines:
  - speakerName: Client
    text: This is the final security chamber. The man ahead is our target.
    portrait: {fileID: 0}
  - speakerName: Drifter
    text: He does not look like a normal guard.
    portrait: {fileID: 0}
  - speakerName: Boss
    text: Guard? No. I am the reason this tower still stands.
    portrait: {fileID: 0}
  - speakerName: Boss
    text: You used shadows to sneak past my men. Impressive, but meaningless.
    portrait: {fileID: 0}
  - speakerName: Client
    text: His attacks will leave brief openings. That is when you strike from the
      shadows.
    portrait: {fileID: 0}
  - speakerName: Drifter
    text: So I wait for the opening, enter the shadow, and take him down.
    portrait: {fileID: 0}
  - speakerName: Drifter
    text: Try it. Step into my shadow, and I will drag you out myself.
    portrait: {fileID: 0}
  waitForEntryWalkBeforeIntro: 1
  maxEntryWalkWaitSeconds: 5
  startDelay: 0.1
